@model Manajemen_Peminjaman_Mobil.Models.EditBookingViewModel
@{
    ViewData["Title"] = "Edit Booking";
}
<h1>Edit Vehicle Booking</h1>
<hr />

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Keperluan" class="control-label"></label>
                <input asp-for="Keperluan" class="form-control" />
                <span asp-validation-for="Keperluan" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Durasi" class="control-label"></label>
                <input asp-for="Durasi" class="form-control" />
                <span asp-validation-for="Durasi" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Tanggal" class="control-label"></label>
                <input asp-for="Tanggal" class="form-control" type="date" />
                <span asp-validation-for="Tanggal" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartMiningId" class="control-label">Pilih Asal</label>
                <select asp-for="StartMiningId" class="form-control" asp-items="@Model.Minings"></select>
                <span asp-validation-for="StartMiningId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndMiningId" class="control-label">Pilih Tujuan</label>
                <select asp-for="EndMiningId" class="form-control" asp-items="@Model.Minings"></select>
                <span asp-validation-for="EndMiningId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EmployeeId" class="control-label">Select Employee</label>
                <select asp-for="EmployeeId" class="form-control" asp-items="@Model.Employees"></select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VehicleId" class="control-label">Select Vehicle</label>
                <select asp-for="VehicleId" class="form-control" asp-items="@Model.Vehicles"></select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DriverName" class="control-label"></label>
                <select asp-for="DriverName" class="form-control" asp-items="@Model.Drivers">
                    <option value="">-- Select Driver --</option>
                </select>
                <span asp-validation-for="DriverName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}