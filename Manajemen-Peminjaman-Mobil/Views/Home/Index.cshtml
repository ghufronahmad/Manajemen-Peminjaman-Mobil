@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
    <div class="col-lg-12 d-flex align-items-strech">
        <div class="card w-100">
            <div class="card-body">
                <div class="d-sm-flex d-block align-items-center justify-content-between mb-9">
                    <div class="mb-3 mb-sm-0">
                        <h5 class="card-title fw-semibold">Grafik Penggunaan Kendaraan</h5>
                        <p class="card-subtitle">Jumlah booking yang disetujui per bulan</p>
                    </div>
                </div>
                <div id="vehicleUsageChart"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/Home/GetVehicleUsageData')
                .then(response => response.json())
                .then(chartData => {

                    var options = {
                        // [DIUBAH] Menggunakan struktur series yang baru dari controller
                        series: chartData.series,

                        // [DIUBAH] Tambahkan properti 'stacked: true'
                        chart: {
                            type: 'bar',
                            height: 350,
                            stacked: true, // <-- INI KUNCINYA
                            toolbar: {
                                show: true
                            }
                        },

                        plotOptions: {
                            bar: {
                                horizontal: false,
                                columnWidth: '60%',
                            },
                        },

                        // [DIUBAH] Tambahkan warna kustom untuk setiap status
                        colors: ['#28a745', '#dc3545', '#ffc107'], // Hijau, Merah, Kuning

                        xaxis: {
                            categories: chartData.labels,
                        },
                        yaxis: {
                            title: {
                                text: 'Jumlah'
                            }
                        },
                        legend: {
                            position: 'top',
                            horizontalAlign: 'left'
                        },
                        fill: {
                            opacity: 1
                        }
                    };

                    var chart = new ApexCharts(document.querySelector("#vehicleUsageChart"), options);
                    chart.render();
                })
                .catch(error => console.error('Error fetching chart data:', error));
        });
    </script>
}